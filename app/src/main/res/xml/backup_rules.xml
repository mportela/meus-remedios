<?xml version="1.0" encoding="utf-8"?>
<!--
  Privacidade (Android < 12): nenhum dado do app é incluído em backups.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
